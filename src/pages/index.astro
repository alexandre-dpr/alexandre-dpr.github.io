---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ui } from '../utils/i18n';
import I18n from '../components/I18n.astro';

const apps = await getCollection('apps');
---

<Layout title="Alexandre Dupré - Portfolio iOS">
    <div class="max-w-5xl mx-auto px-4 py-16">
        <div class="text-center mb-16 opacity-0 animate-fade-in-up">
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-6">
                <I18n id="home.title" />
            </h1>
            <p class="text-xl text-slate-500 max-w-2xl mx-auto">
                <I18n id="home.subtitle" />
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {apps.map((app, index) => {
                const appId = app.id.split('/')[0];
                return Object.entries(ui).map(([lang, translations]) => {
                    const meta = app.data[lang as keyof typeof ui] || app.data.fr || { title: appId, subtitle: '' };
                    return (
                        <a href={`/${appId}`} data-lang={lang} style={`animation-delay: ${100 + index * 100}ms`} class="lang-content group block bg-white rounded-[2rem] p-6 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] hover:shadow-xl transition-all border border-slate-100 hover:border-slate-200 opacity-0 animate-fade-in-up hover:-translate-y-1">
                            <div class="flex flex-col items-center text-center">
                                <div class="w-24 h-24 rounded-[22.5%] mb-6 skeleton-wrapper skeleton shrink-0">
                                    <img src={`/assets/${appId}/icon.png`} alt={meta.title} loading="lazy" decoding="async" class="w-full h-full rounded-[22.5%] shadow-sm border border-slate-100/50 group-hover:scale-105 transition-all duration-300 opacity-0 img-lazy" />
                                </div>
                                <h3 class="text-xl font-bold text-slate-900 mb-2">{meta.title}</h3>
                                <p class="text-slate-500 text-sm line-clamp-2">{meta.subtitle}</p>
                            </div>
                        </a>
                    );
                });
            })}
        </div>
    </div>
</Layout>
