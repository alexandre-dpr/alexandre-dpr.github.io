---
import I18n from '../../components/I18n.astro';
import Layout from '../../layouts/Layout.astro';
import SupportForm from '../../components/SupportForm.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allApps = await getCollection('apps');
  return allApps.map(app => {
    const appId = app.id.split('/')[0];
    return {
      params: { app: appId },
      props: { app }
    };
  });
}

const { app: appId } = Astro.params;
const { app } = Astro.props;

const meta = app.data.fr || { title: appId };

import { ui } from '../../utils/i18n';

const i18nMeta = Object.keys(ui).reduce((acc, lang) => {
    // @ts-ignore
    const title = ui[lang]['app.support'] + ' - ' + (app.data[lang as keyof typeof ui]?.title || meta.title);
    acc[lang] = { title };
    return acc;
}, {} as Record<string, { title: string }>);
---

<Layout title={`Support - ${meta.title}`} image={`/assets/${appId}/icon.png`} i18n={i18nMeta}>
    <div class="w-[95%] md:w-[80%] max-w-3xl mx-auto px-4 py-6 sm:py-12">
        
        {/* Contextual Header */}
        <div class="sticky top-[65px] sm:top-[75px] z-40 mb-6 sm:mb-8 flex flex-row items-center justify-between bg-white/95 backdrop-blur-md p-3 sm:p-5 rounded-2xl sm:rounded-[1.5rem] shadow-sm border border-slate-200/60 gap-3">
            <div class="flex items-center gap-3 sm:gap-4 overflow-hidden">
                <img src={`/assets/${appId}/icon.png`} alt={meta.title} class="w-10 h-10 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl shadow-sm border border-slate-100 shrink-0" />
                <div class="min-w-0">
                    <h2 class="text-base sm:text-xl font-bold text-slate-900 leading-tight truncate">{meta.title}</h2>
                    <p class="text-xs sm:text-sm font-medium text-slate-500 truncate"><I18n id="app.support" /></p>
                </div>
            </div>
            <a href={`/${appId}`} class="shrink-0 px-3 py-2 sm:px-5 sm:py-2.5 bg-slate-50 hover:bg-slate-100 text-slate-700 font-medium rounded-xl text-xs sm:text-sm transition-colors flex items-center justify-center gap-1.5 sm:gap-2 border border-slate-200">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 sm:w-4 sm:h-4"><path d="m15 18-6-6 6-6"/></svg>
                <I18n id="nav.back" />
            </a>
        </div>

        <div class="bg-white p-8 md:p-10 rounded-[2rem] shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] border border-slate-100">
            <div id="support-header">
                <h1 class="text-3xl font-bold tracking-tight text-slate-900 mb-2"><I18n id="support.title" /></h1>
                <p class="text-slate-500 mb-8"><I18n id="support.desc.1" /><strong>{meta.title}</strong><I18n id="support.desc.2" /></p>
            </div>
            
            <SupportForm appTitle={meta.title} />
        </div>
    </div>
</Layout>
