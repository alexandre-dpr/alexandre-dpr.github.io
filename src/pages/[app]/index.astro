---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { ui } from '../../utils/i18n';
import I18n from '../../components/I18n.astro';

export async function getStaticPaths() {
  const allApps = await getCollection('apps');
  return allApps.map(app => {
    const appId = app.id.split('/')[0];
    return {
      params: { app: appId },
      props: { app }
    };
  });
}

const { app: appId } = Astro.params;
const { app } = Astro.props;
const { appStoreUrl, developer, category, compatibility, price } = app.data;
const meta = app.data.fr || { title: appId, subtitle: '' };

const docs = await getCollection('docs');
const localizedDocs = await Promise.all(
  Object.keys(ui).map(async (lang) => {
    const entry = docs.find(d => d.id === `${appId}/description/${lang}`);
    const { Content } = entry ? await render(entry) : { Content: null };
    return { lang, Content };
  })
);

// We need localized meta for the header (title/subtitle)
// But since the UI is entirely client toggled, we have to render all titles/subtitles!
// Actually meta.title is usually the same, but subtitle changes.
const allMeta = Object.keys(ui).map(lang => ({
  lang,
  data: app.data[lang as keyof typeof ui] || meta
}));

const i18nMeta = Object.keys(ui).reduce((acc, lang) => {
    const data = app.data[lang as keyof typeof ui] || meta;
    acc[lang] = {
        title: data.title,
        description: data.subtitle
    };
    return acc;
}, {} as Record<string, { title: string, description: string }>);

const screenshots = [1, 2, 3, 4, 5].map(n => `/assets/${appId}/screenshots/en/${n}.jpg`); // Defaulting to EN screenshots for now for simplicity, or we could render 6 carousels... let's just use EN.
---

<Layout title={meta.title} description={meta.subtitle} i18n={i18nMeta}>
    
    <div class="w-[95%] md:w-[85%] max-w-7xl mx-auto px-4 py-8">
        
        {/* Header App Store */}
        <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start mb-12 opacity-0 animate-fade-in-up">
            <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-[22.5%] skeleton-wrapper skeleton shrink-0 shadow-md">
                <img src={`/assets/${appId}/icon.png`} alt={meta.title} class="w-full h-full rounded-[22.5%] object-cover border border-slate-100/50 transition-opacity duration-300 opacity-0 img-lazy" />
            </div>
            <div class="flex-1 flex flex-col items-center sm:items-start text-center sm:text-left">
                <h1 class="text-3xl font-bold tracking-tight text-slate-900 mb-1">{meta.title}</h1>
                
                {allMeta.map(({lang, data}) => (
                    <h2 data-lang={lang} class="text-xl text-slate-500 mb-4 lang-content">{data.subtitle}</h2>
                ))}

                <div class="flex items-center gap-4 mt-auto">
                    <a href={appStoreUrl} target="_blank" rel="noopener noreferrer" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-full transition-all shadow-sm hover:shadow-md hover:scale-105 active:scale-95">
                        <I18n id="app.get" />
                    </a>
                </div>
            </div>
        </div>

        {/* Screenshots */}
        <div class="relative group/slider mb-12 opacity-0 animate-fade-in-up" style="animation-delay: 150ms">
            <button id="slider-left" class="hidden md:flex absolute -left-5 top-1/2 -translate-y-1/2 z-10 bg-white/95 backdrop-blur shadow-[0_4px_20px_rgb(0,0,0,0.15)] border border-slate-200 w-12 h-12 rounded-full items-center justify-center text-slate-600 hover:text-slate-900 hover:scale-110 active:scale-95 transition-all opacity-0 group-hover/slider:opacity-100 disabled:!opacity-0 disabled:pointer-events-none cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            
            <div id="carousel" class="overflow-x-auto pb-4 snap-x snap-mandatory flex gap-4 hide-scrollbar scroll-smooth">
                {screenshots.map(src => (
                    <div class="skeleton-wrapper skeleton shrink-0 h-[28rem] w-auto aspect-[1290/2796] rounded-[2rem] shadow-sm snap-center sm:snap-start">
                        <img src={src} alt={`Screenshot ${meta.title}`} loading="lazy" decoding="async" class="gallery-img cursor-zoom-in h-full w-full rounded-[2rem] border border-slate-200/60 object-cover bg-slate-100 hover:opacity-95 transition-opacity duration-300 opacity-0 img-lazy" />
                    </div>
                ))}
            </div>

            <button id="slider-right" class="hidden md:flex absolute -right-5 top-1/2 -translate-y-1/2 z-10 bg-white/95 backdrop-blur shadow-[0_4px_20px_rgb(0,0,0,0.15)] border border-slate-200 w-12 h-12 rounded-full items-center justify-center text-slate-600 hover:text-slate-900 hover:scale-110 active:scale-95 transition-all opacity-0 group-hover/slider:opacity-100 disabled:!opacity-0 disabled:pointer-events-none cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
        </div>

        {/* Description */}
        <div class="prose prose-slate prose-a:text-blue-600 mb-12 max-w-none opacity-0 animate-fade-in-up" style="animation-delay: 250ms">
            {localizedDocs.map(({ lang, Content }) => (
                <div data-lang={lang} class="lang-content">
                    {Content ? <Content /> : <p>Description non disponible.</p>}
                </div>
            ))}
        </div>

        <hr class="border-slate-200 mb-8 opacity-0 animate-fade-in" style="animation-delay: 300ms" />

        {/* Informations */}
        <div class="mb-12 opacity-0 animate-fade-in-up" style="animation-delay: 350ms">
            <h3 class="text-xl font-bold mb-6"><I18n id="app.information" /></h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-12 text-sm">
                <div class="flex justify-between border-b border-slate-100 pb-3">
                    <span class="text-slate-500"><I18n id="app.developer" /></span>
                    <span class="font-medium text-slate-900 ml-4 text-right">{developer}</span>
                </div>
                <div class="flex justify-between border-b border-slate-100 pb-3">
                    <span class="text-slate-500"><I18n id="app.category" /></span>
                    <span class="font-medium text-slate-900 ml-4 text-right">{category}</span>
                </div>
                <div class="flex justify-between border-b border-slate-100 pb-3">
                    <span class="text-slate-500"><I18n id="app.compatibility" /></span>
                    <span class="font-medium text-slate-900 ml-4 text-right">{compatibility}</span>
                </div>
                <div class="flex justify-between border-b border-slate-100 pb-3">
                    <span class="text-slate-500"><I18n id="app.price" /></span>
                    <span class="font-medium text-slate-900 ml-4 text-right">{price}</span>
                </div>
            </div>
        </div>

        <hr class="border-slate-200 mb-8 opacity-0 animate-fade-in" style="animation-delay: 400ms" />

        {/* Links */}
        <div class="flex flex-col gap-4">
            <a href={`/${appId}/support`} class="flex items-center p-4 bg-white rounded-2xl hover:bg-slate-50 transition-all border border-slate-100 hover:border-slate-200 group hover:shadow-md hover:-translate-y-0.5 opacity-0 animate-fade-in-up" style="animation-delay: 450ms">
                <span class="text-blue-600 mr-3 opacity-80">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v5Z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg>
                </span>
                <span class="font-medium text-blue-600 flex-1"><I18n id="app.support" /></span>
                <span class="text-slate-400 group-hover:translate-x-1 transition-transform">→</span>
            </a>
            <a href={`/${appId}/privacy`} class="flex items-center p-4 bg-white rounded-2xl hover:bg-slate-50 transition-all border border-slate-100 hover:border-slate-200 group hover:shadow-md hover:-translate-y-0.5 opacity-0 animate-fade-in-up" style="animation-delay: 500ms">
                <span class="text-blue-600 mr-3 opacity-80">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <span class="font-medium text-blue-600 flex-1"><I18n id="app.privacy" /></span>
                <span class="text-slate-400 group-hover:translate-x-1 transition-transform">→</span>
            </a>
            <a href={`/${appId}/terms`} class="flex items-center p-4 bg-white rounded-2xl hover:bg-slate-50 transition-all border border-slate-100 hover:border-slate-200 group hover:shadow-md hover:-translate-y-0.5 opacity-0 animate-fade-in-up" style="animation-delay: 550ms">
                <span class="text-blue-600 mr-3 opacity-80">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
                </span>
                <span class="font-medium text-blue-600 flex-1"><I18n id="app.terms" /></span>
                <span class="text-slate-400 group-hover:translate-x-1 transition-transform">→</span>
            </a>
        </div>
    </div>
    
    {/* Fullscreen Dialog */}
    <dialog id="fs-dialog" class="backdrop:bg-black/95 bg-transparent m-auto p-0 border-0 max-w-[100vw] max-h-[100vh] w-full h-full text-center">
        <div class="fs-close-target absolute inset-0 cursor-zoom-out w-full h-full flex items-center justify-center p-4">
            <img id="fs-img" src="" class="max-h-[95vh] max-w-[95vw] object-contain rounded-2xl shadow-2xl mx-auto cursor-default select-none" />
            
            <button id="fs-prev" class="absolute left-4 sm:left-8 top-1/2 -translate-y-1/2 bg-white/10 hover:bg-white/20 text-white rounded-full p-3 backdrop-blur transition-all cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            
            <button id="fs-next" class="absolute right-4 sm:right-8 top-1/2 -translate-y-1/2 bg-white/10 hover:bg-white/20 text-white rounded-full p-3 backdrop-blur transition-all cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
            
            <button class="fs-close-btn absolute top-4 right-4 sm:top-8 sm:right-8 bg-white/10 hover:bg-white/20 text-white rounded-full p-2 backdrop-blur transition-all cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>
    </dialog>

    <script>
        class AppGalleryController {
            private dialog: HTMLDialogElement;
            private fsImg: HTMLImageElement;
            private galleryImgs: HTMLImageElement[];
            private closeTarget: HTMLElement;
            private btnPrev: HTMLElement | null;
            private btnNext: HTMLElement | null;
            private btnClose: HTMLElement | null;
            private carousel: HTMLElement;
            private btnLeft: HTMLButtonElement | null;
            private btnRight: HTMLButtonElement | null;
            private currentIndex = 0;

            constructor() {
                this.dialog = document.getElementById('fs-dialog') as HTMLDialogElement;
                this.fsImg = document.getElementById('fs-img') as HTMLImageElement;
                this.galleryImgs = Array.from(document.querySelectorAll('.gallery-img')) as HTMLImageElement[];
                this.closeTarget = document.querySelector('.fs-close-target') as HTMLElement;
                this.btnPrev = document.getElementById('fs-prev');
                this.btnNext = document.getElementById('fs-next');
                this.btnClose = document.querySelector('.fs-close-btn');
                
                this.carousel = document.getElementById('carousel') as HTMLElement;
                this.btnLeft = document.getElementById('slider-left') as HTMLButtonElement | null;
                this.btnRight = document.getElementById('slider-right') as HTMLButtonElement | null;

                if (!this.dialog || !this.fsImg || this.galleryImgs.length === 0) return;

                this.initFullscreen();
                this.initCarousel();
                this.initLanguageListener();
            }

            private updateFsImage(index: number) {
                if (index < 0) index = this.galleryImgs.length - 1;
                if (index >= this.galleryImgs.length) index = 0;
                this.currentIndex = index;
                this.fsImg.src = this.galleryImgs[this.currentIndex].src;
            }

            private initFullscreen() {
                this.galleryImgs.forEach((img, index) => {
                    img.addEventListener('click', () => {
                        this.updateFsImage(index);
                        this.dialog.showModal();
                    });
                });

                if (this.btnPrev && this.btnNext) {
                    this.btnPrev.addEventListener('click', (e) => { e.stopPropagation(); this.updateFsImage(this.currentIndex - 1); });
                    this.btnNext.addEventListener('click', (e) => { e.stopPropagation(); this.updateFsImage(this.currentIndex + 1); });
                }

                if (this.closeTarget) {
                    this.closeTarget.addEventListener('click', (e) => {
                        const target = e.target as Element;
                        if (target === this.closeTarget || target === this.btnClose || target.closest('.fs-close-btn')) {
                            this.dialog.close();
                        }
                    });
                }
                
                document.addEventListener('keydown', (e) => {
                    if (!this.dialog.open) return;
                    if (e.key === 'ArrowLeft') this.updateFsImage(this.currentIndex - 1);
                    if (e.key === 'ArrowRight') this.updateFsImage(this.currentIndex + 1);
                    if (e.key === 'Escape') this.dialog.close();
                });
            }

            private updateImagesLang(lang: string) {
                this.galleryImgs.forEach(img => {
                    const currentSrc = img.src;
                    const newSrc = currentSrc.replace(/\/screenshots\/[a-z]{2}\//, `/screenshots/${lang}/`);
                    if (currentSrc !== newSrc) {
                        const wrapper = img.closest('.skeleton-wrapper');
                        if (wrapper) wrapper.classList.add('skeleton'); 
                        img.classList.add('opacity-0'); 
                        img.src = newSrc;
                    }
                });
                window.dispatchEvent(new CustomEvent('update-skeletons'));
            }

            private initLanguageListener() {
                const initialLang = document.documentElement.lang || 'en';
                this.updateImagesLang(initialLang);

                window.addEventListener('languageChanged', ((e: CustomEvent) => {
                    this.updateImagesLang(e.detail.lang);
                }) as EventListener);
            }

            private initCarousel() {
                if (!this.btnLeft || !this.btnRight || !this.carousel) return;
                
                this.btnLeft.addEventListener('click', () => {
                    this.carousel.scrollBy({ left: -320, behavior: 'smooth' });
                });
                this.btnRight.addEventListener('click', () => {
                    this.carousel.scrollBy({ left: 320, behavior: 'smooth' });
                });
                
                const updateButtons = () => {
                    if (!this.btnLeft || !this.btnRight) return;
                    this.btnLeft.disabled = this.carousel.scrollLeft <= 0;
                    this.btnRight.disabled = this.carousel.scrollLeft >= this.carousel.scrollWidth - this.carousel.clientWidth - 2;
                };
                
                this.carousel.addEventListener('scroll', updateButtons, { passive: true });
                setTimeout(updateButtons, 100);
            }
        }

        document.addEventListener('astro:page-load', () => {
            new AppGalleryController();
        });
    </script>
    
    <style>
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</Layout>
